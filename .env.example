# Copy this file to .env and paste your real values there.
# Never share .env in screenshots or chat.

PORT=3000
NODE_ENV=development

# Meta Graph API version shown in your API setup page.
GRAPH_API_VERSION=v25.0

# From Meta Developer App -> Connect on WhatsApp -> Basic setup -> Step 1. Try it out
WHATSAPP_TOKEN=paste_generated_access_token_here
WHATSAPP_PHONE_NUMBER_ID=1107576985771392
WHATSAPP_WABA_ID=2850166098660100

# Create your own random text. Paste the same value in Meta webhook configuration.
WHATSAPP_VERIFY_TOKEN=change_this_to_a_random_verify_token

# From Meta Developer App -> App settings -> Basic -> App secret
# Required for X-Hub-Signature-256 validation on POST /webhook.
META_APP_SECRET=paste_meta_app_secret_here

# Optional: set to false only if you are doing a temporary local test before adding app secret.
VALIDATE_META_SIGNATURE=true

# Fallback venue name used in the greeting when no wa_numbers/{phone_number_id}
# mapping exists yet (e.g. the throwaway test number).
VENUE_NAME=our venue

# How long a "Chat with Venue" handoff keeps the bot silent (ms). Default 6h.
HUMAN_MODE_TTL_MS=21600000

# Firebase Web config for the GameOn project. These are PUBLIC client
# identifiers (already shipped in the app bundle), not secrets. Only set these
# to point at a different Firebase project than the built-in turf-app-930c5.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
