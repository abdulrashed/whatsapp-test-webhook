# Copy this file to .env and paste your real values there.
# Never share .env in screenshots or chat.

PORT=3000
NODE_ENV=development
GRAPH_API_VERSION=v25.0

# --- Meta / WhatsApp Cloud API (global) ---
# Multi-tenant: the send token, phone_number_id and flow id are per-venue,
# stored on each venue_details doc (wa_access_token / phone_number_id /
# wa_flow_id). Nothing per-venue is set here. Below are the only global values,
# used to validate the single inbound webhook shared by every venue.

# Your own random text; paste the same value in the Meta webhook configuration.
WHATSAPP_VERIFY_TOKEN=change_this_to_a_random_verify_token
# Meta Developer App -> App settings -> Basic -> App secret (X-Hub-Signature-256).
META_APP_SECRET=paste_meta_app_secret_here
# Set to false only for a temporary local test before adding the app secret.
VALIDATE_META_SIGNATURE=true

# Optional fallback venue_details doc id, used only when an inbound
# phone_number_id matches no venue. Leave unset in a fully-mapped deployment.
# VENUE_ID=

# How long a "Chat with Venue" handoff keeps the bot silent (ms). Default 6h.
HUMAN_MODE_TTL_MS=21600000

# --- Firebase (GameOn project) ---
# PUBLIC client identifiers, not secrets. src/config.js defaults to
# turf-app-930c5; set these only to point at a different Firebase project.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- WhatsApp Flow (booking) ---
# Flow id is per-venue (venue_details.wa_flow_id). This RSA key (one shared pair;
# upload its public half to every number) decrypts the Flow requests. Paste with
# literal \n between lines, e.g. "-----BEGIN...-----\nMIIE...\n-----END...-----".
FLOW_PRIVATE_KEY=
# Passphrase if the private key is encrypted. Blank if not.
FLOW_KEY_PASSPHRASE=

# --- Payments (GameOn PHP backend) ---
# Only ONE pair active at a time; both endpoints must match (TEST order_id won't
# open on LIVE checkout). If unset, src/config.js falls back to LIVE.
# TEST — Razorpay test keys, no real money moves.
# CHECKOUT_BASE_URL=https://eleganzainfotech.com/v2_checkout_test.html
# CREATE_ORDER_URL=https://eleganzainfotech.com/v2_create_order_test.php
# LIVE — real payments.
# CHECKOUT_BASE_URL=https://eleganzainfotech.com/v2_checkout_live.html
# CREATE_ORDER_URL=https://eleganzainfotech.com/v2_create_order_live.php

# Shared secret the Razorpay webhook uses to call POST /payment-notify (sends the
# WhatsApp booking confirmation). Empty means the endpoint refuses every request.
# Set the same long random value on the PHP side.
PAYMENT_NOTIFY_SECRET=change_this_to_a_long_random_secret
