{
  "version": "7.0",
  "data_api_version": "3.0",
  "routing_model": {
    "SPORT": ["DATE", "INFO"],
    "DATE": ["COURT", "TIME", "INFO"],
    "COURT": ["TIME", "INFO"],
    "TIME": ["DURATION", "INFO"],
    "DURATION": ["SUMMARY", "INFO"],
    "SUMMARY": [],
    "INFO": []
  },
  "screens": [
    {
      "id": "SPORT",
      "title": "Choose a sport",
      "data": {
        "sports": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "main-content": { "type": "object" },
              "on-click-action": { "type": "object" }
            }
          },
          "__example__": [
            {
              "main-content": { "title": "Football" },
              "on-click-action": {
                "name": "data_exchange",
                "payload": { "sport_name": "Football" }
              }
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "sport_list",
            "list-items": "${data.sports}"
          }
        ]
      }
    },
    {
      "id": "DATE",
      "title": "Select a date",
      "data": {
        "g1_label": { "type": "string", "__example__": "July 2026" },
        "g1_days": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [{ "id": "2026-07-26", "title": "26 Sun" }]
        },
        "g2_visible": { "type": "boolean", "__example__": true },
        "g2_label": { "type": "string", "__example__": "August 2026" },
        "g2_days": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [{ "id": "2026-08-01", "title": "1 Sat" }]
        },
        "g3_visible": { "type": "boolean", "__example__": false },
        "g3_label": { "type": "string", "__example__": "" },
        "g3_days": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": []
        },
        "g4_visible": { "type": "boolean", "__example__": false },
        "g4_label": { "type": "string", "__example__": "" },
        "g4_days": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": []
        },
        "sport_name": { "type": "string", "__example__": "Football" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "ChipsSelector",
            "name": "date_g1",
            "label": "${data.g1_label}",
            "required": false,
            "max-selected-items": 1,
            "data-source": "${data.g1_days}"
          },
          {
            "type": "ChipsSelector",
            "name": "date_g2",
            "label": "${data.g2_label}",
            "visible": "${data.g2_visible}",
            "required": false,
            "max-selected-items": 1,
            "data-source": "${data.g2_days}"
          },
          {
            "type": "ChipsSelector",
            "name": "date_g3",
            "label": "${data.g3_label}",
            "visible": "${data.g3_visible}",
            "required": false,
            "max-selected-items": 1,
            "data-source": "${data.g3_days}"
          },
          {
            "type": "ChipsSelector",
            "name": "date_g4",
            "label": "${data.g4_label}",
            "visible": "${data.g4_visible}",
            "required": false,
            "max-selected-items": 1,
            "data-source": "${data.g4_days}"
          },
          {
            "type": "Footer",
            "label": "Next",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "sport_name": "${data.sport_name}",
                "date_g1": "${form.date_g1}",
                "date_g2": "${form.date_g2}",
                "date_g3": "${form.date_g3}",
                "date_g4": "${form.date_g4}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "COURT",
      "title": "Choose a court",
      "data": {
        "courts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "main-content": { "type": "object" },
              "on-click-action": { "type": "object" }
            }
          },
          "__example__": [
            {
              "main-content": { "title": "Court 1" },
              "on-click-action": {
                "name": "data_exchange",
                "payload": {
                  "sport_name": "Football",
                  "date": "2026-07-26",
                  "court_id": "court1",
                  "court_name": "Court 1"
                }
              }
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "court_list",
            "list-items": "${data.courts}"
          }
        ]
      }
    },
    {
      "id": "TIME",
      "title": "Pick a start time",
      "data": {
        "times": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "main-content": { "type": "object" },
              "on-click-action": { "type": "object" }
            }
          },
          "__example__": [
            {
              "main-content": { "title": "6:00 AM" },
              "on-click-action": {
                "name": "data_exchange",
                "payload": {
                  "sport_name": "Football",
                  "date": "2026-07-26",
                  "court_id": "court1",
                  "court_name": "Court 1",
                  "start_time": "06:00"
                }
              }
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "time_list",
            "list-items": "${data.times}"
          }
        ]
      }
    },
    {
      "id": "DURATION",
      "title": "How long?",
      "data": {
        "durations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "main-content": { "type": "object" },
              "end": { "type": "object" },
              "on-click-action": { "type": "object" }
            }
          },
          "__example__": [
            {
              "main-content": { "title": "1 hour", "metadata": "ends 7:00 AM" },
              "end": { "title": "₹300" },
              "on-click-action": {
                "name": "data_exchange",
                "payload": {
                  "sport_name": "Football",
                  "date": "2026-07-26",
                  "court_id": "court1",
                  "court_name": "Court 1",
                  "start_time": "06:00",
                  "duration": "1"
                }
              }
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "duration_list",
            "list-items": "${data.durations}"
          }
        ]
      }
    },
    {
      "id": "SUMMARY",
      "title": "Confirm & pay",
      "terminal": true,
      "data": {
        "summary_text": { "type": "string", "__example__": "Booking summary" },
        "sport_name": { "type": "string", "__example__": "Football" },
        "date": { "type": "string", "__example__": "2026-07-26" },
        "court_id": { "type": "string", "__example__": "court1" },
        "court_name": { "type": "string", "__example__": "Court 1" },
        "start_time": { "type": "string", "__example__": "06:00" },
        "end_time": { "type": "string", "__example__": "08:00" },
        "price": { "type": "string", "__example__": "600" },
        "advance": { "type": "string", "__example__": "200" },
        "pay_amount": { "type": "string", "__example__": "200" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "${data.summary_text}"
          },
          {
            "type": "ChipsSelector",
            "name": "pay_method",
            "label": "Pay using",
            "required": false,
            "max-selected-items": 1,
            "data-source": [
              { "id": "gpay", "title": "GPay" },
              { "id": "phonepe", "title": "PhonePe" },
              { "id": "paytm", "title": "Paytm" },
              { "id": "upi", "title": "Other UPI" },
              { "id": "card", "title": "Card" }
            ]
          },
          {
            "type": "Footer",
            "label": "Confirm & Pay",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "sport_name": "${data.sport_name}",
                "date": "${data.date}",
                "court_id": "${data.court_id}",
                "court_name": "${data.court_name}",
                "start_time": "${data.start_time}",
                "end_time": "${data.end_time}",
                "price": "${data.price}",
                "advance": "${data.advance}",
                "pay_amount": "${data.pay_amount}",
                "pay_method": "${form.pay_method}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "INFO",
      "title": "Booking",
      "terminal": true,
      "data": {
        "info_text": { "type": "string", "__example__": "No slots available." }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "${data.info_text}"
          },
          {
            "type": "Footer",
            "label": "Close",
            "on-click-action": {
              "name": "complete",
              "payload": { "status": "closed" }
            }
          }
        ]
      }
    }
  ]
}
