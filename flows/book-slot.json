{
  "version": "7.1",
  "data_api_version": "3.0",
  "routing_model": {
    "SPORT": ["DATE", "INFO"],
    "DATE": ["COURT", "TIME", "INFO"],
    "COURT": ["TIME", "INFO"],
    "TIME": ["DURATION", "INFO"],
    "DURATION": ["SUMMARY", "INFO"],
    "SUMMARY": [],
    "INFO": []
  },
  "screens": [
    {
      "id": "SPORT",
      "title": "Choose a sport",
      "data": {
        "sports": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [{ "id": "Football", "title": "Football" }]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "ChipsSelector",
            "name": "sport",
            "label": "Sport",
            "required": true,
            "max-selected-items": 1,
            "data-source": "${data.sports}",
            "on-select-action": {
              "name": "data_exchange",
              "payload": { "sport_name": "${form.sport}" }
            }
          }
        ]
      }
    },
    {
      "id": "DATE",
      "title": "Select a date",
      "data": {
        "g1_label": { "type": "string", "__example__": "July 2026" },
        "g1_days": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "2026-07-26", "title": "26 Sun" },
            { "id": "2026-07-27", "title": "27 Mon" },
            { "id": "2026-07-28", "title": "28 Tue" },
            { "id": "2026-07-29", "title": "29 Wed" },
            { "id": "2026-07-30", "title": "30 Thu" },
            { "id": "2026-07-31", "title": "31 Fri" }
          ]
        },
        "g2_visible": { "type": "boolean", "__example__": false },
        "g2_label": { "type": "string", "__example__": "August 2026" },
        "g2_days": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [{ "id": "2026-08-01", "title": "1 Sat" }]
        },
        "g3_visible": { "type": "boolean", "__example__": false },
        "g3_label": { "type": "string", "__example__": " " },
        "g3_days": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": []
        },
        "g4_visible": { "type": "boolean", "__example__": false },
        "g4_label": { "type": "string", "__example__": " " },
        "g4_days": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": []
        },
        "sport_name": { "type": "string", "__example__": "Football" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "ChipsSelector",
            "name": "date_g1",
            "label": "${data.g1_label}",
            "required": true,
            "max-selected-items": 1,
            "data-source": "${data.g1_days}",
            "on-select-action": {
              "name": "data_exchange",
              "payload": {
                "sport_name": "${data.sport_name}",
                "date_g1": "${form.date_g1}"
              }
            }
          },
          {
            "type": "ChipsSelector",
            "name": "date_g2",
            "label": "${data.g2_label}",
            "visible": "${data.g2_visible}",
            "required": false,
            "max-selected-items": 1,
            "data-source": "${data.g2_days}",
            "on-select-action": {
              "name": "data_exchange",
              "payload": {
                "sport_name": "${data.sport_name}",
                "date_g2": "${form.date_g2}"
              }
            }
          },
          {
            "type": "ChipsSelector",
            "name": "date_g3",
            "label": "${data.g3_label}",
            "visible": "${data.g3_visible}",
            "required": false,
            "max-selected-items": 1,
            "data-source": "${data.g3_days}",
            "on-select-action": {
              "name": "data_exchange",
              "payload": {
                "sport_name": "${data.sport_name}",
                "date_g3": "${form.date_g3}"
              }
            }
          },
          {
            "type": "ChipsSelector",
            "name": "date_g4",
            "label": "${data.g4_label}",
            "visible": "${data.g4_visible}",
            "required": false,
            "max-selected-items": 1,
            "data-source": "${data.g4_days}",
            "on-select-action": {
              "name": "data_exchange",
              "payload": {
                "sport_name": "${data.sport_name}",
                "date_g4": "${form.date_g4}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "COURT",
      "title": "Choose a court",
      "data": {
        "courts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [{ "id": "court1", "title": "Court 1" }]
        },
        "sport_name": { "type": "string", "__example__": "Football" },
        "date": { "type": "string", "__example__": "2026-07-26" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "ChipsSelector",
            "name": "court",
            "label": "Court",
            "required": true,
            "max-selected-items": 1,
            "data-source": "${data.courts}",
            "on-select-action": {
              "name": "data_exchange",
              "payload": {
                "sport_name": "${data.sport_name}",
                "date": "${data.date}",
                "court_id": "${form.court}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "TIME",
      "title": "Pick a start time",
      "data": {
        "times_am": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [{ "id": "06:00", "title": "6:00 AM" }]
        },
        "times_pm": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [{ "id": "18:00", "title": "6:00 PM" }]
        },
        "am_visible": { "type": "boolean", "__example__": true },
        "pm_visible": { "type": "boolean", "__example__": true },
        "sport_name": { "type": "string", "__example__": "Football" },
        "date": { "type": "string", "__example__": "2026-07-26" },
        "court_id": { "type": "string", "__example__": "court1" },
        "court_name": { "type": "string", "__example__": "Court 1" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "ChipsSelector",
            "name": "start_time_am",
            "label": "Morning",
            "visible": "${data.am_visible}",
            "required": false,
            "max-selected-items": 1,
            "data-source": "${data.times_am}",
            "on-select-action": {
              "name": "data_exchange",
              "payload": {
                "sport_name": "${data.sport_name}",
                "date": "${data.date}",
                "court_id": "${data.court_id}",
                "court_name": "${data.court_name}",
                "start_time_am": "${form.start_time_am}"
              }
            }
          },
          {
            "type": "ChipsSelector",
            "name": "start_time_pm",
            "label": "Afternoon & Evening",
            "visible": "${data.pm_visible}",
            "required": false,
            "max-selected-items": 1,
            "data-source": "${data.times_pm}",
            "on-select-action": {
              "name": "data_exchange",
              "payload": {
                "sport_name": "${data.sport_name}",
                "date": "${data.date}",
                "court_id": "${data.court_id}",
                "court_name": "${data.court_name}",
                "start_time_pm": "${form.start_time_pm}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "DURATION",
      "title": "How long?",
      "data": {
        "durations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [{ "id": "1", "title": "1h · till 7 AM · ₹300" }]
        },
        "sport_name": { "type": "string", "__example__": "Football" },
        "date": { "type": "string", "__example__": "2026-07-26" },
        "court_id": { "type": "string", "__example__": "court1" },
        "court_name": { "type": "string", "__example__": "Court 1" },
        "start_time": { "type": "string", "__example__": "06:00" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "ChipsSelector",
            "name": "duration",
            "label": "Duration",
            "required": true,
            "max-selected-items": 1,
            "data-source": "${data.durations}",
            "on-select-action": {
              "name": "data_exchange",
              "payload": {
                "sport_name": "${data.sport_name}",
                "date": "${data.date}",
                "court_id": "${data.court_id}",
                "court_name": "${data.court_name}",
                "start_time": "${data.start_time}",
                "duration": "${form.duration}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SUMMARY",
      "title": "Confirm & pay",
      "terminal": true,
      "data": {
        "summary_text": { "type": "string", "__example__": "Booking summary" },
        "sport_name": { "type": "string", "__example__": "Football" },
        "date": { "type": "string", "__example__": "2026-07-26" },
        "court_id": { "type": "string", "__example__": "court1" },
        "court_name": { "type": "string", "__example__": "Court 1" },
        "start_time": { "type": "string", "__example__": "06:00" },
        "end_time": { "type": "string", "__example__": "08:00" },
        "price": { "type": "string", "__example__": "600" },
        "advance": { "type": "string", "__example__": "200" },
        "pay_amount": { "type": "string", "__example__": "200" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "${data.summary_text}"
          },
          {
            "type": "Footer",
            "label": "Confirm & Pay",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "sport_name": "${data.sport_name}",
                "date": "${data.date}",
                "court_id": "${data.court_id}",
                "court_name": "${data.court_name}",
                "start_time": "${data.start_time}",
                "end_time": "${data.end_time}",
                "price": "${data.price}",
                "advance": "${data.advance}",
                "pay_amount": "${data.pay_amount}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "INFO",
      "title": "Booking",
      "terminal": true,
      "data": {
        "info_text": { "type": "string", "__example__": "No slots available." }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "${data.info_text}"
          },
          {
            "type": "Footer",
            "label": "Close",
            "on-click-action": {
              "name": "complete",
              "payload": { "status": "closed" }
            }
          }
        ]
      }
    }
  ]
}
